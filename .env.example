APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# The app almost always sits behind something that terminates TLS. If its
# forwarded headers are not trusted, Laravel decides the request is plain http
# and builds every URL that way — the service worker will not register and
# printed QR codes point at a scheme the site does not answer on.
# `*` is right when the proxy's address is not fixed (most PaaS, cPanel).
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 LTS is the production target. SQLite is left as the default so a
# fresh checkout runs without provisioning a database server; the migrations are
# written to run on both.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=opes360
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. `log` writes messages to storage/logs instead of sending them, which is
# right for local work and fatal in production — password reset links would
# never reach anyone. Set a real transport before launch and confirm it with
# `php artisan opes:doctor --mail=you@yourdomain.com`.
#
# The from-address domain needs SPF and DKIM published, or mail is filtered as
# spam and users simply never receive it — which looks identical to a bug.
# For cPanel/Namecheap mail, the working combination is:
#   MAIL_MAILER=smtp
#   MAIL_HOST=mail.yourdomain.com
#   MAIL_PORT=465
#   MAIL_SCHEME=smtps          <- 465 needs implicit TLS; 587 uses `tls` instead
#   MAIL_USERNAME=no-reply@yourdomain.com
# The from-address must be a real mailbox on the sending domain or the server
# refuses to relay it. See docs/DEPLOY-NAMECHEAP.md §4.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Account mail is queued, so a worker must be running or nothing is delivered:
#   php artisan queue:work --tries=3
# `opes:doctor` warns when the backlog says no worker is up.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Subscription billing. Both are optional — the billing page hides whichever
# provider has no credentials set, so a fresh install works with neither
# configured. See docs/DEPLOYMENT.md for how to obtain each.
#
# MTN Mobile Money (Collections API, momodeveloper.mtn.com). Provision an API
# user/key against your subscription key in the developer portal (or the
# sandbox self-signup) before setting these.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_DEFAULT_COUNTRY_CODE=237

# Orange Money Web Payment (developer.orange.com/apis/om-webpay). client_id/
# client_secret come from an Orange Developer application; merchant_key comes
# separately from your Orange Money merchant account.
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_COUNTRY=cm
ORANGE_MONEY_LANG=fr
